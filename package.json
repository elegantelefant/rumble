{
  "name": "elefant-rumble",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "generate:api": "orval",
    "dev:sidecar": "cd src-tauri/sidecar && uv run python main.py --port 11435",
    "generate:models": "cd src-tauri/sidecar && uv run datamodel-codegen --input ../../openapi.json --output models/generated.py --output-model-type pydantic_v2.BaseModel --target-python-version 3.12 --type-mappings string+ulid=string --snake-case-field --no-alias",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.92.9",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "lucide-vue-next": "^0.545.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.21",
    "happy-dom": "^20.8.3",
    "orval": "^8.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^4.0.18",
    "vue-tsc": "^2.1.10"
  },
  "productDisplayName": "Elefant - Rumble"
}
