{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/rumble-sidecar",
          "sidecar": true,
          "args": [
            "--port",
            { "validator": "\\d+" },
            "--data-dir",
            { "validator": ".+" }
          ]
        }
      ]
    }
  ]
}
