<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Tauri signs the app and the bundled sidecar with these (bundle.macOS.entitlements).
     The ad-hoc-signed sidecar is a PyInstaller onefile binary that dlopens the Python
     library it unpacks at launch; under the hardened runtime, library validation refuses
     it ("different Team IDs": ad-hoc signatures have none) unless this is set (#157). -->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
